# Виртуальное окружение и кэши Python
.venv/
venv/
__pycache__/
*.py[cod]

# Кэш адресов робота (создаётся в ~/.config, но на всякий случай)
addresses.json

# Автосохранение и временные файлы редактора в папке программ
programs/_draft.txt
programs/_edit_*.txt

# Собранный HTML инструкций (генерируется docs/build.sh из markdown)
docs/*.html
