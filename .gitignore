# Виртуальное окружение и кэши Python
.venv/
venv/
__pycache__/
*.py[cod]

# Кэш адресов робота (создаётся в ~/.config, но на всякий случай)
addresses.json

# Папка программ — пользовательская: свои программы не коммитим,
# в репозитории остаётся только программа-пример
programs/*
!programs/программа-2026-10-18-1245.txt
# (заодно закрыты _draft.txt и _edit_*.txt — их пишет редактор)

# Собранный HTML инструкций (генерируется docs/build.sh из markdown)
docs/*.html

# Сборка инструкций: текст с проставленными номерами страниц и карта страниц
docs/*.pages.md
docs/*.pages.json*
