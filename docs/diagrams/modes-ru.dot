// Три режима пульта и как между ними ходить (русская версия).
// Собирается docs/build.sh в docs/img/modes-ru.svg
digraph modes {
  graph [rankdir=TB, bgcolor="transparent", pad=0.14, nodesep=0.45, ranksep=0.55];
  node  [fontname="Noto Sans", fontsize=13, shape=box, style="rounded,filled",
         fillcolor="#eef3fb", color="#4a6fa5", penwidth=1.5, margin="0.20,0.11"];
  edge  [fontname="Noto Sans", fontsize=11, color="#8a97a8", arrowsize=0.8, penwidth=1.4,
         fontcolor="#55606d"];

  remote [label="ПУЛЬТ\nw a s d — едешь сам", fillcolor="#dff0d8", color="#5a9e4b"];
  editor [label="ПРОГРАММА\nнабираешь шаги", fillcolor="#fdf0d5", color="#c99a2e"];
  run [label="ПРОГОН\nробот едет сам", fillcolor="#f3e6f7", color="#9b6bb5"];

  remote -> editor [label="p"];
  editor -> run [label="Enter"];
  run -> editor [label="p   (правка)", constraint=false];
  run -> remote [label="Esc", constraint=false];
  editor -> remote [label="Esc", constraint=false];
}
